# Gere uma chave no portal de desenvolvedores da SPTrans para usar o Modo Real.
SPTRANS_API_TOKEN=
SPTRANS_BASE_URL=https://api.olhovivo.sptrans.com.br
SPTRANS_API_VERSION=v2.1
SPTRANS_TIMEOUT_SECONDS=15

# Configurações locais do TwoBus.
TWOBUS_REFRESH_SECONDS=60
TWOBUS_STALE_SECONDS=180
TWOBUS_DB_PATH=data/twobus.db
